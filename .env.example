# ==============================================================================
# Konfigurasi Environment Variables - Pendaftaran Yayasan Mardiah
# Salin file ini menjadi .env jika menjalankan di lingkungan lokal:
# cp .env.example .env
# Untuk Vercel: Masukkan key-value ini di Settings > Environment Variables
# ==============================================================================

# Kredensial TiDB Cloud Serverless
# Dapatkan dari TiDB Cloud Console -> Cluster Overview -> Connect -> General
TIDB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=your_username_prefix.root
TIDB_PASSWORD=your_secure_password
TIDB_DATABASE=yayasan_mardiah

# Path CA Certificate untuk koneksi SSL/TLS TiDB Cloud
# Di lingkungan Linux / Vercel Serverless, Anda dapat mengosongkan nilai ini karena
# sistem config.php akan otomatis mendeteksi '/etc/pki/tls/certs/ca-bundle.crt'
# atau '/etc/ssl/certs/ca-certificates.crt'.
# Jika di Windows atau ingin menentukan file custom secara eksplisit:
# TIDB_SSL_CA=C:/xampp/perl/vendor/lib/Mozilla/CA/cacert.pem
TIDB_SSL_CA=

# Mode Aplikasi: 'development' atau 'production'
# Pada mode 'production', pesan error database tidak akan mengekspos detail teknis sensitif ke client.
APP_ENV=production
