# ==============================================================================
# Konfigurasi Environment Variables - Pendaftaran Yayasan Mardiah
# Berkas ini aktif untuk pengujian lokal (XAMPP / PHP built-in server)
# Untuk Vercel: Masukkan nilai ini di Dashboard Vercel > Settings > Environment Variables
# ==============================================================================

# Pengaturan Database Lokal (XAMPP Default)
# Jika ingin menghubungkan ke TiDB Cloud Serverless dari lokal, ganti nilai di bawah ini:
TIDB_HOST=127.0.0.1
TIDB_PORT=3306
TIDB_USER=root
TIDB_PASSWORD=
TIDB_DATABASE=yayasan_mardiah

# Path SSL CA (Hanya diperlukan untuk TiDB Cloud Serverless)
TIDB_SSL_CA=

# Mode Aplikasi ('development' menampilkan rincian error saat pengujian lokal)
APP_ENV=development
